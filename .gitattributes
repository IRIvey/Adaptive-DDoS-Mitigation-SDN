# Scripts run under MSYS2 bash, which chokes on Windows line endings. Without
# this, a teammate cloning on Windows gets CRLF files and every .sh fails with
# "$'\r': command not found".
*.sh   text eol=lf
*.py   text eol=lf
*.ned  text eol=lf
*.ini  text eol=lf
*.msg  text eol=lf
*.cc   text eol=lf
*.h    text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.csv  text eol=lf

# cmd.exe needs CRLF
*.cmd  text eol=crlf

*.png  binary
