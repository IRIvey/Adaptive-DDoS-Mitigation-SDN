# Simulation output: gigabytes of .vec/.sca files, regenerated by every run.
# The aggregated results that matter live in results/ and are committed.
simulations/results/

# Build output - regenerated by build.sh
src/out/
src/Makefile
src/*_m.cc
src/*_m.h
src/*.exe
# The Linux build has no extension - a bare "sdnddos" slipped past the rule
# above once and got committed. Name it explicitly rather than trying to
# glob-match "no extension" safely.
src/sdnddos

# Per-run and per-user OMNeT++ state: the Cmdenv log, and the GUI's saved
# window layout, which is specific to whoever last opened it
simulations/.cmdenv-log
simulations/.qtenvrc

# Python environment - recreate with:
#   python -m venv .venv
#   .venv\Scripts\python.exe -m pip install scikit-learn pandas numpy matplotlib joblib
.venv/
__pycache__/
*.pyc

# Leftover from an abandoned attack experiment; not used by any result
data/flows_syn.csv

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
